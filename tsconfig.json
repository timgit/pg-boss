{
  "extends": [
    "@tsconfig/node22/tsconfig.json",
    "@tsconfig/node-ts/tsconfig.json"
  ],
  "compilerOptions": {
    "types": ["node", "vitest/globals"],
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "stripInternal": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "rootDir": "./",
  },
  // test/bun imports `bun` and `bun:test` and reaches for Bun globals, so it needs @types/bun in
  // scope - which would then also be in scope for src and the vitest suite. It is checked by
  // tsconfig.bun.json instead, run as the first half of `npm run test:bun`. test/types-dist imports
  // the built dist/ and is checked by its own config in `npm run test:types-dist`.
  "include": ["src", "test"],
  "exclude": ["test/bun", "test/types-dist"]
}