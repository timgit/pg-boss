{
  "name": "bun-boss",
  "version": "0.2.3",
  "description": "Queueing jobs in Postgres, PGlite, and SQLite from Bun like a boss",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "engines": {
    "bun": ">=1.3.14"
  },
  "dependencies": {
    "@types/bun": "^1.3.14",
    "croner": "^10.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "neostandard": "^0.13.0",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "prepublishOnly": "bun install && bun run test",
    "pretest": "bun run tsc",
    "test": "eslint . && bun test --parallel --timeout 120000",
    "test:no-skip-locked-no-cte": "NO_SKIP_LOCKED_NO_CTE=true bun run test",
    "test:pglite": "DB_TYPE=pglite bun run test",
    "test:sqlite": "DB_TYPE=sqlite bun run test",
    "lint:fix": "eslint . --fix",
    "cover": "bun run test -- --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "tsc": "tsc --noEmit",
    "console": "bun scripts/console.js",
    "docs:llms": "bun scripts/build-llms.ts"
  },
  "bunboss": {
    "schema": 1
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khromov/bun-boss.git"
  },
  "author": "Stanislav Khromov",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/khromov/bun-boss/issues"
  },
  "homepage": "https://github.com/khromov/bun-boss",
  "keywords": [
    "postgresql",
    "postgres",
    "sqlite",
    "bun",
    "queue",
    "job"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "package.json"
  ]
}
