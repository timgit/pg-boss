{
  "name": "pg-boss",
  "version": "0.1.0",
  "description": "Queueing jobs in Postgres, SQLite, and memory from Bun like a boss",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "cron-parser": "^5.7.0",
    "pg": "^8.22.0",
    "serialize-error": "^13.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/node22": "^22.0.5",
    "@types/bun": "^1.3.14",
    "@types/luxon": "^3.7.3",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.3",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9.39.5",
    "luxon": "^3.7.2",
    "neostandard": "^0.13.0",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18"
  },
  "scripts": {
    "build": "bun run clean && tsc --project tsconfig.build.json",
    "clean": "bun -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "bun install && bun run test && bun run build",
    "pretest": "bun run tsc",
    "test": "eslint . && bun --bun vitest run",
    "test:no-skip-locked-no-cte": "NO_SKIP_LOCKED_NO_CTE=true bun run test",
    "test:pglite": "DB_TYPE=pglite bun run test",
    "test:sqlite": "DB_TYPE=sqlite bun run test",
    "test:bun": "DB_TYPE=bun bun run test",
    "lint:fix": "eslint . --fix",
    "cover": "bun run test -- --coverage",
    "tsc": "tsc --noEmit",
    "console": "bun scripts/console.js"
  },
  "pgboss": {
    "schema": 1
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timgit/pg-boss.git"
  },
  "author": "timgit",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/timgit/pg-boss/issues"
  },
  "homepage": "https://pgboss.io",
  "keywords": [
    "postgresql",
    "postgres",
    "queue",
    "job"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ]
}
