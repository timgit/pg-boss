{
  "name": "pg-boss",
  "version": "12.27.0",
  "description": "Queueing jobs in Postgres, SQLite, and memory from Bun like a boss",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pg-boss": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "cron-parser": "^5.7.0",
    "pg": "^8.22.0",
    "serialize-error": "^13.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@tsconfig/node-ts": "^23.6.4",
    "@tsconfig/node22": "^22.0.5",
    "@types/bun": "^1.3.14",
    "@types/luxon": "^3.7.3",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.3",
    "@vitest/coverage-v8": "^4.1.2",
    "cli-testlab": "^6.0.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "luxon": "^3.7.2",
    "neostandard": "^0.13.0",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18"
  },
  "scripts": {
    "build": "bun run clean && tsc --project tsconfig.build.json",
    "clean": "bun -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "bun install && bun run test && bun run build",
    "pretest": "bun run tsc && bun run gen:manifest:check",
    "test": "eslint . && bun --bun vitest run",
    "test:distributed": "cross-env DISTRIBUTED=true bun run test",
    "test:ci": "bun run cover && cross-env DISTRIBUTED=true bun run cover && bun run test:pglite && bun run test:bun",
    "test:cockroachdb": "cross-env DB_TYPE=cockroachdb COCKROACH_HOST=localhost bun run test -- test/distributedDatabaseTest.ts",
    "test:cockroachdb:full": "cross-env DB_TYPE=cockroachdb COCKROACH_HOST=localhost bun run test -- --no-file-parallelism",
    "test:yugabytedb:full": "cross-env DB_TYPE=yugabytedb YUGABYTE_HOST=localhost bun run test -- --no-file-parallelism",
    "test:citus:full": "cross-env DB_TYPE=citus CITUS_HOST=localhost bun run test",
    "test:pglite": "cross-env DB_TYPE=pglite bun run test",
    "test:bun": "cross-env DB_TYPE=bun bun run test",
    "lint:fix": "eslint . --fix",
    "cover": "bun run test -- --coverage",
    "tsc": "tsc --noEmit",
    "cli": "bun ./dist/cli.js",
    "gen:manifest": "bun scripts/gen-manifest.ts",
    "gen:manifest:check": "bun scripts/gen-manifest.ts --check",
    "console": "bun scripts/console.js"
  },
  "pgboss": {
    "schema": 37
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timgit/pg-boss.git"
  },
  "author": "timgit",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/timgit/pg-boss/issues"
  },
  "homepage": "https://pgboss.io",
  "keywords": [
    "postgresql",
    "postgres",
    "queue",
    "job"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ]
}
